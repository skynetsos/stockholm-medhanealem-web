# Staging environment (committee review) for docker-compose.prod.yml — docs/RUNBOOK.md → Staging.
# Copy to .env.staging ON THE STAGING SERVER ONLY (never commit it) and replace every value.
# Use NEW secrets and a SEPARATE database and bucket: nothing is shared with production.
# Generate secrets with: openssl rand -hex 32

# ─── Site ─────────────────────────────────────────────────────────────
# "staging": never indexed (robots.txt disallows everything), forms work without the privacy notice,
# and the review content may be published with the placeholder approval (refused in production).
SITE_ENV=staging
SITE_DOMAIN=staging.medhanealem.se
# Compiled into the app at build time: rebuild after changing it.
NEXT_PUBLIC_SERVER_URL=https://staging.medhanealem.se
# Read by docker compose for the app and tools containers.
APP_ENV_FILE=.env.staging
# Own containers and volumes, so staging can never touch production's database.
COMPOSE_PROJECT_NAME=medhanealem-staging

# ─── Review password (Caddy basic auth, deploy/caddy/staging-auth.caddy.example) ─
STAGING_AUTH_USER=committee
# The bcrypt hash from `caddy hash-password`. Write every $ as $$ (docker compose reads $ as a variable).
STAGING_AUTH_HASH=replace-with-hash

# ─── Secrets ──────────────────────────────────────────────────────────
PAYLOAD_SECRET=replace-with-openssl-rand-hex-32
MFA_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
IP_HASH_SALT=replace-with-openssl-rand-hex-32
CRON_SECRET=replace-with-openssl-rand-hex-32

# ─── Database (container on the same server, not published) ─────────
POSTGRES_USER=medhanealem
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
POSTGRES_DB=medhanealem_staging

# ─── Media storage: its own bucket, never the production one ─────────
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=medhanealem-staging-media
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=true

# ─── Email (optional on staging) ──────────────────────────────────────
# Empty: emails are only written to the app log (docker compose logs app), nobody is mailed.
# With a Resend key, test messages really go out (to the office addresses in Site settings).
EMAIL_FROM=no-reply@medhanealem.se
EMAIL_FROM_NAME=Stockholm Medhanealem (staging)
RESEND_API_KEY=

# ─── Forms: Cloudflare Turnstile (optional on staging) ───────────────
# Empty: the check is skipped (only allowed outside production). The password already keeps bots out.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Observability (optional) ─────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
