# Production environment for docker-compose.prod.yml.
# Copy to .env.production ON THE SERVER ONLY (never commit it) and replace every value.
# Generate secrets with: openssl rand -hex 32
# Back up PAYLOAD_SECRET, MFA_ENCRYPTION_KEY and BACKUP_PASSPHRASE with the church's password manager
# (docs/RUNBOOK.md → Secrets that must be backed up).

# ─── Site ─────────────────────────────────────────────────────────────
SITE_ENV=production
# Domain Caddy serves and gets certificates for (no scheme).
SITE_DOMAIN=medhanealem.se
# Public URL, compiled into the app at build time: rebuild the image after changing it.
NEXT_PUBLIC_SERVER_URL=https://medhanealem.se
# Optional: different host ports (e.g. for a local test of this stack)
# HTTP_PORT=80
# HTTPS_PORT=443

# ─── Secrets ──────────────────────────────────────────────────────────
PAYLOAD_SECRET=replace-with-openssl-rand-hex-32
MFA_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
IP_HASH_SALT=replace-with-openssl-rand-hex-32
CRON_SECRET=replace-with-openssl-rand-hex-32

# ─── Database (container on the same server, not published) ─────────
POSTGRES_USER=medhanealem
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
POSTGRES_DB=medhanealem

# ─── Media storage (EU S3-compatible: Hetzner Object Storage or Cloudflare R2) ─
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=fsn1
S3_BUCKET=medhanealem-media
S3_ACCESS_KEY_ID=replace-me
S3_SECRET_ACCESS_KEY=replace-me
S3_FORCE_PATH_STYLE=true

# ─── Email (Resend) ───────────────────────────────────────────────────
EMAIL_FROM=no-reply@medhanealem.se
EMAIL_FROM_NAME=Stockholm Medhanealem
RESEND_API_KEY=replace-me

# ─── Forms: Cloudflare Turnstile (real keys from the Cloudflare dashboard) ─
# Read at runtime (not baked into the build). Without TURNSTILE_SECRET_KEY, forms refuse every
# message when SITE_ENV=production, so a missing key can never switch spam protection off.
TURNSTILE_SITE_KEY=replace-me
TURNSTILE_SECRET_KEY=replace-me

# ─── Observability (optional) ─────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ─── Backups (scripts/backup/*.sh) ────────────────────────────────────
# Encryption passphrase for database dumps. Losing it makes every backup unreadable.
BACKUP_PASSPHRASE=replace-with-openssl-rand-hex-32
# Off-server copy: a SEPARATE bucket (ideally another provider/region) with versioning + 30-day lifecycle.
BACKUP_S3_ENDPOINT=https://hel1.your-objectstorage.com
BACKUP_S3_REGION=hel1
BACKUP_S3_BUCKET=medhanealem-backups
BACKUP_S3_ACCESS_KEY_ID=replace-me
BACKUP_S3_SECRET_ACCESS_KEY=replace-me
