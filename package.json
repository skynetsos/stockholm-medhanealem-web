{
  "name": "stockholm-medhanealem-web",
  "version": "0.0.0",
  "private": true,
  "description": "Website for Debre Selam Menbere Papasat Medhanealem Ethiopian Orthodox Tewahedo Church, Stockholm",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e:prepare": "node scripts/e2e-prepare.mjs",
    "test:e2e": "playwright test",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs -f",
    "seed:base": "payload run scripts/seed-base.ts",
    "user:create-super-admin": "payload run scripts/create-super-admin.ts",
    "user:reset-mfa": "payload run scripts/reset-mfa.ts",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@12.11.2",
  "dependencies": {
    "@payloadcms/db-postgres": "3.91.0",
    "@payloadcms/next": "3.91.0",
    "@payloadcms/richtext-lexical": "3.91.0",
    "@payloadcms/storage-s3": "3.91.0",
    "@payloadcms/translations": "3.91.0",
    "@payloadcms/ui": "3.91.0",
    "graphql": "^16.14.2",
    "next": "15.4.11",
    "next-intl": "4.14.9",
    "otplib": "13.5.0",
    "payload": "3.91.0",
    "qrcode": "1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.4.11",
    "pg": "8.20.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  }
}
