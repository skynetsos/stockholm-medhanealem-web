# Stockholm Medhanealem website — environment variables
# Copy to .env for local development:  cp .env.example .env
# Values below are for LOCAL DEVELOPMENT ONLY. Never reuse them on staging or production.
# "Used from" says which phase/task first reads the variable.

# ─── App ──────────────────────────────────────────────────────────────
# development | staging | production. Non-production sets robots to noindex. (Phase 1)
SITE_ENV=development
# Public base URL of the site, no trailing slash. Payload serverURL + absolute links. (Phase 0)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Payload signing secret (JWT, cookies). 32+ random bytes; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-with-64-hex-chars

# ─── Database (PostgreSQL 16) ─────────────────────────────────────────
# Used by docker-compose.yml to create the local database.
POSTGRES_USER=medhanealem
POSTGRES_PASSWORD=medhanealem_dev
POSTGRES_DB=medhanealem
POSTGRES_PORT=5432
# Connection string the app uses. Must match the values above locally. (Phase 0)
DATABASE_URI=postgres://medhanealem:medhanealem_dev@localhost:5432/medhanealem

# ─── Object storage (S3-compatible, EU in production) ─────────────────
# Local: RustFS from docker-compose.yml. Production: Hetzner Object Storage or Cloudflare R2. (Phase 0)
S3_ENDPOINT=http://localhost:9000
# Any value works locally; production uses the provider's EU region (e.g. fsn1, auto for R2).
S3_REGION=us-east-1
S3_BUCKET=medhanealem-media
S3_ACCESS_KEY_ID=medhanealem
S3_SECRET_ACCESS_KEY=medhanealem_dev_secret
# true for RustFS/MinIO/Hetzner (path-style URLs); false for providers needing virtual-host style.
S3_FORCE_PATH_STYLE=true

# ─── Email ────────────────────────────────────────────────────────────
# Sender address for all outgoing mail. Must be a verified domain in Resend for production. (Phase 1)
EMAIL_FROM=no-reply@medhanealem.se
# Resend API key. Leave EMPTY locally: mail then goes over SMTP to Mailpit (http://localhost:8025).
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025

# ─── Forms: spam protection and privacy (Phase 1–2) ───────────────────
# Cloudflare Turnstile. These are Cloudflare's official always-pass TEST keys for local dev.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Salt for hashing client IPs before storing/rate-limiting (we never store raw IPs). Random 32+ bytes.
IP_HASH_SALT=replace-with-random-hex
# Shared secret that protects /api/cron/* routes such as the retention job (Phase 2).
CRON_SECRET=replace-with-random-hex

# ─── Observability (deferred: Phase 0 task 12 skipped for local-first) ─
# Leave empty to disable Sentry.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
