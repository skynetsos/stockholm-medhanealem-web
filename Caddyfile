# Reverse proxy with automatic HTTPS (Let's Encrypt). SITE_DOMAIN comes from .env.production.
# With Cloudflare in front: use SSL mode "Full (strict)". See docs/RUNBOOK.md → Production.

# The visitor's real address (review F-10): Caddy believes CF-Connecting-IP only when the request comes
# from Cloudflare's own network; for anyone else it uses the connection's address. The app reads only
# the X-Real-IP that Caddy sets below. Cloudflare's ranges: https://www.cloudflare.com/ips/ (check
# them when deploying and yearly).
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}
{$SITE_DOMAIN} {
	encode zstd gzip

	# Extra rules for this server only, e.g. the staging password (docs/RUNBOOK.md → Staging). The folder
	# is empty in production; a pattern that matches no file is allowed.
	import /etc/caddy/site.d/*.caddy

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	reverse_proxy app:3000 {
		# Replaces any X-Real-IP the client sent.
		header_up X-Real-IP {client_ip}
		health_uri /api/health
		health_interval 30s
	}
}
